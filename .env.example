# Required: search + profile photos (https://serper.dev)
SERPER_API_KEY=

# AI features (JD analysis, scoring, finding more candidates). Claude is tried first, Gemini is the fallback.
# Set either one or both.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Access protection. REQUIRED when NODE_ENV=production (the server refuses to start without it, so a public
# URL can't be used to spend your credits). Anyone opening the site is asked for this password (any user name).
APP_PASSWORD=
# ALLOW_OPEN=true            # only to run production WITHOUT a password (not recommended)
# TRUST_PROXY=true           # behind nginx / Render: use X-Forwarded-For as the client address for rate limits
# RATE_LIMIT_PER_MIN=120     # API calls per client per minute

PORT=4100

# Optional per-task model overrides (defaults: cheap and fast for parsing, stronger for scoring)
# CLAUDE_PARSE_MODEL=claude-haiku-5-5
# CLAUDE_RANK_MODEL=claude-sonnet-5-5
# GEMINI_PARSE_MODEL=gemini-3.5-flash-lite
# GEMINI_RANK_MODEL=gemini-3.6-flash
